// prisma/schema.prisma
// Run: npx prisma db push  (after updating .env with DATABASE_URL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (NextAuth standard models) ─────────────────────────────
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  phone         String?   @unique // for Twilio SMS commands
  dashboardMode  String?   @default("advanced") // "easy" | "advanced"
  // White-label
  wlCompanyName String?
  wlLogoUrl     String?
  wlPrimaryColor String?
  // Integrations
  gaPropertyId  String?   // Google Analytics 4 property ID
  socialTokens  Json?     // { twitter, facebook, instagram, linkedin }
  // Reporting
  reportEmail   String?   // send monthly reports here
  reportEnabled Boolean   @default(false)
  password      String?   // null for OAuth-only users (bcrypt hashed)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  sites          Site[]
  scheduledPosts ScheduledPost[]
  provisions     SiteProvision[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── ignyous Sites ────────────────────────────────────────────────
model Site {
  id          String    @id @default(cuid())
  userId      String
  url         String
  name        String?
  apiKey      String
  theme       String?
  builder     String?
  wpVersion   String?
  connectedAt DateTime  @default(now())
  lastSeen    DateTime?
  scanData    Json?     // cached scan report
  memory      Json?     // per-site AI memory

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  uptimeLogs  UptimeLog[]
  teamMembers TeamMember[]
  brokenLinks BrokenLink[]
  agentRuns   AgentRun[]

  agentConfigs Json?    // { health: { enabled, schedule }, seo: { enabled, threshold }, ... }
  @@unique([userId, url])
}

// ─── Activity Log ─────────────────────────────────────────────────
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  siteUrl    String?
  siteName   String?
  category   String   // ai_action | content | snapshot | plugin | page | settings | auth | system
  action     String   // e.g. update_page, create_post, take_snapshot, install_plugin, login
  status     String   @default("success") // success | failed | pending
  summary    String   // human-readable one-liner
  detail     Json?    // full action payload / result
  ipAddress  String?
  userAgent  String?
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([siteUrl])
  @@index([category])
}
model ScheduledPost {
  id            String   @id @default(cuid())
  siteId        String
  userId        String
  title         String
  content       String   @db.Text
  excerpt       String?
  topics        String[] // tags/topics
  imageUrl      String?
  imageAlt      String?
  status        String   @default("pending_approval") // pending_approval | approved | scheduled | published | rejected
  approvalToken String?  @unique
  frequency     String?  // daily | weekly | monthly | once
  scheduledFor  DateTime?
  publishedAt   DateTime?
  wpPostId      Int?
  publishedUrl  String?
  seoTitle      String?
  seoDescription String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Uptime Monitoring ────────────────────────────────────────────
model UptimeLog {
  id        String   @id @default(cuid())
  siteId    String
  status    String   // "up" | "down" | "degraded"
  latencyMs Int?
  checkedAt DateTime @default(now())
  error     String?
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, checkedAt])
}

// ─── Team Members ─────────────────────────────────────────────────
model TeamMember {
  id          String   @id @default(cuid())
  siteId      String
  invitedBy   String   // userId
  email       String
  role        String   @default("viewer") // "viewer" | "editor" | "admin"
  status      String   @default("pending") // "pending" | "active"
  inviteToken String?  @unique
  joinedAt    DateTime?
  createdAt   DateTime @default(now())
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, email])
}

// ─── Broken Link Reports ──────────────────────────────────────────
model BrokenLink {
  id          String   @id @default(cuid())
  siteId      String
  sourceUrl   String
  brokenUrl   String
  statusCode  Int?
  scannedAt   DateTime @default(now())
  fixed       Boolean  @default(false)
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

// ─── AI Agents ────────────────────────────────────────────────
model AgentRun {
  id          String   @id @default(cuid())
  siteId      String
  agentType   String   // "health" | "seo" | "content" | "security" | "plugin_updater" | "woocommerce" | "multisite_sync"
  status      String   // "running" | "completed" | "failed" | "skipped"
  actionsLog  Json?    // array of { action, result, timestamp }
  summary     String?
  triggeredBy String   @default("cron") // "cron" | "manual" | "event"
  startedAt   DateTime @default(now())
  completedAt DateTime?
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, agentType])
}

// ─── Site Provisioning ────────────────────────────────────────
model SiteProvision {
  id            String    @id @default(cuid())
  userId        String
  status        String    @default("pending") // pending|provisioning|building|ready|failed
  siteSlug      String    @unique
  tempDomain    String?
  customDomain  String?
  hostingTier   String    @default("basic")   // basic|medium|large
  hostingProvider String  @default("wpengine")
  description   String?
  features      Json?     // selected features array
  themeSlug     String?
  themeName     String?
  builder       String?   // gutenberg|elementor|avada
  buildLog      Json?     // array of {step, status, message, timestamp}
  siteId        String?   // once provisioned, links to Site
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
